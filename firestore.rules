rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. DỮ LIỆU CV PORTFOLIO: Khách CHỈ ĐƯỢC PHÉP ĐỌC, CẤM GHI / SỬA / XÓA
    // Khách dù lấy được API Key cũng KHÔNG THỂ chỉnh sửa hay xóa bất kỳ dữ liệu nào
    match /profile/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /projects/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /education/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /skills/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /mindset/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 2. KHÁCH ĐỂ LẠI LIÊN HỆ (CONTACTS)
    // Chỉ cho phép gửi tin nhắn mới, không cho phép khách đọc trộm hoặc sửa/xóa tin nhắn của người khác
    match /contacts/{document=**} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // 3. MẶC ĐỊNH KHÓA TẤT CẢ CÁC ĐƯỜNG TRUY CẬP KHÁC
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
